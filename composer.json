{
  "name": "dzentota/typedvalue",
  "description": "A PHP 8.3+ typed values (value objects) helper library with modern enum support and comprehensive security features.",
  "license": "MIT",
  "authors": [
    {
      "name": "Alex Tatulchenkov",
      "email": "webtota@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "dzentota\\TypedValue\\": "src/",
      "tests\\dzentota\\TypedValue\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --no-progress"
  }
}
